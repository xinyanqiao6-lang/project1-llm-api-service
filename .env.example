# 复制本文件为 .env 后填写。.env 不要提交到 GitHub（已在 .gitignore 里排除）！

# 硅基流动 API Key（注册 https://cloud.siliconflow.cn 后在"API 密钥"页创建）
SILICONFLOW_API_KEY=

# 上游地址与模型（免费额度可用的模型，按需换）
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
MODEL=Qwen/Qwen2.5-7B-Instruct

# 缓存
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# 限流：60 秒内每个客户端最多 10 次
RATE_LIMIT=10
RATE_WINDOW=60

# 上游韧性（超时 / 重试 / 熔断）：针对免费模型偶发 60s 挂起拖爆 P99 的问题
LLM_TIMEOUT=30              # 单次请求总超时（秒），原 60s 收紧到 30s
LLM_CONNECT_TIMEOUT=5       # 连接超时（秒）
LLM_MAX_RETRIES=2           # 最多重试次数（仅对超时/连接错误/5xx 重试）
LLM_RETRY_BACKOFF=0.5       # 指数退避基数（秒）：0.5→1→2
CIRCUIT_FAIL_THRESHOLD=5    # 连续失败 N 次触发熔断
CIRCUIT_COOLDOWN=30         # 熔断冷却期（秒）

# MOCK_MODE=true 时不调真实 API（无 Key 时先跑通链路用；压测数字不可写进简历）
MOCK_MODE=false
PORT=8000
