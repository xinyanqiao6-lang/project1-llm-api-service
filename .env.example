# 复制本文件为 .env 后填写。.env 不要提交到 GitHub（已在 .gitignore 里排除）！

# 硅基流动 API Key（注册 https://cloud.siliconflow.cn 后在"API 密钥"页创建）
SILICONFLOW_API_KEY=

# 上游地址与模型（免费额度可用的模型，按需换）
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
MODEL=Qwen/Qwen2.5-7B-Instruct

# 缓存
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# 限流：60 秒内每个客户端最多 10 次
RATE_LIMIT=10
RATE_WINDOW=60

# MOCK_MODE=true 时不调真实 API（无 Key 时先跑通链路用；压测数字不可写进简历）
MOCK_MODE=false
PORT=8000
